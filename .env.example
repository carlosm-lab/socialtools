# Paddle Billing Configuration (Production or Sandbox)
# Environment: "production" or "sandbox"
NEXT_PUBLIC_PADDLE_ENV=production

# Public Client-side Token from Paddle -> Developer Tools -> Authentication
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paddle Price IDs from Catalog -> Products
NEXT_PUBLIC_PADDLE_CREATOR_PRICE_ID=pri_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_CREATOR_YEARLY_PRICE_ID=pri_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_AGENCY_MONTHLY_PRICE_ID=pri_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_AGENCY_YEARLY_PRICE_ID=pri_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_CREDITS_PRICE_ID=pri_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side Secret API Key from Paddle -> Developer Tools -> Authentication (NEVER commit real key)
PADDLE_API_KEY=pdl_live_apikey_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret from Paddle -> Developer Tools -> Notifications (NEVER commit real secret)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth 2.0 Web Client Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Canonical Production App URL & Session Signing Secret (32+ random bytes hex/base64)
NEXT_PUBLIC_APP_URL=https://www.socialtools.click
AUTH_SECRET=replace_with_64_char_random_hex_secret
